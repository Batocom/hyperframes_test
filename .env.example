# Contract only — values come from Codespaces secrets (auto-injected as env vars).
# Copy to .env for local runs if not in a codespace. Never fill real values here.

# Stock photo/video search — https://www.pexels.com/api/
PEXELS_API_KEY=

# Groq — whisper transcription + fast LLM checks — https://console.groq.com/keys
GROQ_API_KEY=

# HeyGen — prefer OAuth inside the codespace (`heygen auth login --oauth`).
# If using an API key instead (bills API credits): https://platform.heygen.com/api-keys
# HEYGEN_API_KEY=
